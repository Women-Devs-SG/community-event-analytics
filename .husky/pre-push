#!/bin/sh
# Run the same checks as CI before anything leaves this machine, using synthetic data.
# Checks inspect the working tree, so uncommitted changes can affect the result.
export VITE_DATA_SOURCE=synthetic
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo 'Note: you have uncommitted changes; pre-push checks include them.' >&2
fi
exec npm run verify
