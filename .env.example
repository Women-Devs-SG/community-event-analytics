# Synthetic data is the safe default and requires no configuration.
VITE_DATA_SOURCE=synthetic
VITE_REPORTING_TIMEZONE=UTC

# To read a Google Sheet, set VITE_DATA_SOURCE=google-sheets and the values below.
# The sheet is read once, at build time (`npm run summary`). Only privacy-safe
# summaries are published; the sheet ID, tab names, and key never reach the site.
# VITE_DATA_SOURCE=google-sheets
# VITE_SOURCE_LABEL=Community reporting sheet
# GOOGLE_SHEET_ID=replace_with_your_sheet_id
# GOOGLE_TAB_EVENTS=events
# GOOGLE_TAB_SURVEY_RESPONSES=survey_responses
# GOOGLE_TAB_FEEDBACK_ANSWERS=feedback_answers
# GOOGLE_TAB_REGISTRATIONS=registrations
# GOOGLE_TAB_PARTICIPANTS=participants
#
# Recommended: keep the sheet private, share it (Viewer) with a Google Cloud
# service account, and paste the account's whole JSON key on one line. Without
# a key, the build falls back to the sheet's public link and prints a warning.
# Never commit a real key; .env is gitignored.
# GOOGLE_SERVICE_ACCOUNT_KEY={"client_email":"...","private_key":"..."}

# Private dashboard: viewers sign in with Google and see live data, but only if
# the reporting sheet is shared with their account. The sheet is read by an Apps
# Script web app (apps-script/Code.gs). Nothing is published at build time.
# Setup guide: docs/google-signin.md
# VITE_DATA_SOURCE=google-signin
# VITE_SOURCE_LABEL=Community reporting sheet
# VITE_GOOGLE_OAUTH_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec

# Optional community identity and theme overrides
# VITE_COMMUNITY_NAME=Example Community
# VITE_COMMUNITY_SHORT_NAME=EC
# VITE_COMMUNITY_LOCATION=Online
# VITE_DASHBOARD_TITLE=Event Analytics
# VITE_DASHBOARD_SUBTITLE=Our community event insights
# VITE_DASHBOARD_FOOTER=Example Community · anonymized reporting data
# VITE_COLOR_PRIMARY=#3157c8
# VITE_COLOR_SECONDARY=#0f766e
# VITE_COLOR_ACCENT=#d97706
